# ===========================================
# ChurchShare Production Environment Configuration
# ===========================================
# Copy this file to .env and fill in your production values
# cp .env.production .env
#
# IMPORTANT: Never commit .env file to version control!
# ===========================================

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
# Use strong, unique passwords for production
# Generate with: openssl rand -base64 32
POSTGRES_USER=churchshare
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD
POSTGRES_DB=churchshare_db

# ===========================================
# JWT Authentication
# ===========================================
# CRITICAL: Generate a strong, unique secret for production
# Use: openssl rand -base64 64
# Example output: aB3cD4eF5gH6iJ7kL8mN9oP0qR1sT2uV3wX4yZ5aB6cD7eF8gH9iJ0kL1mN2oP3qR4sT5uV6wX7yZ8=
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_KEY

# ===========================================
# Cloudflare R2 Storage Configuration
# ===========================================
# Get these from Cloudflare Dashboard > R2 > API Tokens
# Endpoint format: https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=CHANGE_ME_YOUR_R2_ACCESS_KEY_ID
R2_SECRET_KEY=CHANGE_ME_YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=churchshare-bucket

# ===========================================
# Application URLs
# ===========================================
# Update these with your production domain
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com/api
SERVER_NAME=your-domain.com

# ===========================================
# Spring Boot Configuration
# ===========================================
SPRING_PROFILES_ACTIVE=prod

# ===========================================
# Optional: Email Configuration (SMTP)
# ===========================================
# Configure for password reset and notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@your-domain.com
# SMTP_PASSWORD=your-app-password
# SMTP_PROPERTIES_MAIL_SMTP_AUTH=true
# SMTP_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# ===========================================
# Optional: Monitoring Configuration
# ===========================================
# Enable for production monitoring
# SENTRY_DSN=your-sentry-dsn
# PROMETHEUS_ENABLED=true

# ===========================================
# Security Notes
# ===========================================
# 1. Generate unique passwords/secrets for each environment
# 2. Rotate secrets regularly (every 90 days recommended)
# 3. Use a secrets manager in production (e.g., HashiCorp Vault)
# 4. Never share .env files or commit them to git
# 5. Restrict .env file permissions: chmod 600 .env

# ===========================================
# Password/Secret Generation Commands
# ===========================================
# PostgreSQL password: openssl rand -base64 32
# JWT secret: openssl rand -base64 64
# R2 credentials: Generate in Cloudflare Dashboard
