# =============================================================================
# ChurchShare Frontend - Angular v21, TypeScript 5.9+
# Multi-stage build for optimized production image
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Build
# -----------------------------------------------------------------------------
FROM node:20.11.0-alpine AS build

WORKDIR /app

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies (cache this layer)
RUN npm ci --legacy-peer-deps

# Copy source code
COPY . .

# Build for production
RUN npm run build -- --configuration production

# -----------------------------------------------------------------------------
# Stage 2: Development (with hot reload)
# -----------------------------------------------------------------------------
FROM node:20.11.0-alpine AS development

WORKDIR /app

# Install git for potential npm installs from git repos
RUN apk add --no-cache git

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source code (will be overridden by volume mount)
COPY . .

# Expose dev server port
EXPOSE 4200

# Set environment for Angular
ENV NG_HOST=0.0.0.0
ENV NG_PORT=4200

# Start development server
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0", "--port", "4200"]

# -----------------------------------------------------------------------------
# Stage 3: Production Runtime (nginx)
# -----------------------------------------------------------------------------
FROM nginx:1.25-alpine AS production

# Copy custom nginx configuration
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built Angular app from build stage
COPY --from=build /app/dist/churchshare/browser /usr/share/nginx/html

# Create health check endpoint
RUN mkdir -p /usr/share/nginx/html/health && \
    echo 'OK' > /usr/share/nginx/html/health/index.html

# Expose HTTP port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
