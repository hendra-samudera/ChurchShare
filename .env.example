# =============================================================================
# ChurchShare Environment Variables
# Copy this file to .env and update values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_DB=churchshare
POSTGRES_USER=churchshare
POSTGRES_PASSWORD=CHANGE_ME_in_production
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# JDBC URL (constructed from above)
# SPRING_DATASOURCE_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# Storage Configuration (Cloudflare R2 / MinIO)
# -----------------------------------------------------------------------------
# For local development (MinIO)
STORAGE_TYPE=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_BUCKET=churchshare-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_secret
STORAGE_REGION=auto

# For production (Cloudflare R2)
# STORAGE_TYPE=r2
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_BUCKET=churchshare-prod
# STORAGE_ACCESS_KEY=<R2_ACCESS_KEY>
# STORAGE_SECRET_KEY=<R2_SECRET_KEY>
# STORAGE_REGION=auto

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Generate a strong secret for production: openssl rand -base64 32
JWT_SECRET=churchshare_dev_jwt_secret_key_please_change_in_production
JWT_EXPIRATION_MS=604800000
# 604800000 ms = 7 days

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Spring Boot Actuator
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE=health,info

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# API base URL for Angular environment
API_BASE_URL=http://localhost:8080

# Development server
NG_HOST=0.0.0.0
NG_PORT=4200

# -----------------------------------------------------------------------------
# Docker Configuration
# -----------------------------------------------------------------------------
DOCKER_NETWORK=churchshare-network

# -----------------------------------------------------------------------------
# MinIO Console (Local Development Only)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_CONSOLE_PORT=9001
