# ===========================================
# ChurchShare .gitignore
# Monorepo: Java Spring Boot + React
# ===========================================

# ===========================================
# IDE & Editor
# ===========================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath

# ===========================================
# Java / Spring Boot
# ===========================================
# Compiled class files
*.class

# Log files
*.log

# Package files
*.jar
*.war
*.ear
*.nar

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# Spring Boot
spring-boot-devtools.properties

# ===========================================
# React / Node.js
# ===========================================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Production build
build/
dist/
.next/
out/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage/
.nyc_output/

# Misc
.eslintcache
.stylelintcache

# ===========================================
# Docker
# ===========================================
# Docker volumes (keep configs)
docker/nginx/ssl/
*.pem
*.key
*.crt

# Docker compose override
docker-compose.override.yml
docker-compose.*.yml

# ===========================================
# Database
# ===========================================
# SQL dumps
*.sql
!docker/postgres/init.sql

# Database files
*.db
*.sqlite
*.sqlite3

# ===========================================
# OS Generated Files
# ===========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*

# ===========================================
# Documentation & Temporary
# ===========================================
# Temporary files
tmp/
temp/
*.tmp
*.temp

# Backup files
*.bak
*.backup
*.old

# Notes
*.md~
*.txt~

# ===========================================
# Secrets & Credentials
# ===========================================
# Never commit these
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
*.credentials

# ===========================================
# Application Specific
# ===========================================
# Upload directories
uploads/
storage/
files/

# Cache directories
.cache/
__pycache__/
*.pyc

# ===========================================
# Keep these files (exceptions)
# ===========================================
# Keep Docker init scripts
!docker/**/init.sql
!docker/**/init.sh

# Keep example env files
!.env.example
!.env.template

# Keep README files
!README.md
!**/README.md

# Keep Dockerfiles
!Dockerfile
!**/Dockerfile

# Keep configuration templates
!*.example
!*.template
!*.sample
